@@ -32,6 +32,15 @@
 
 #define BLOCK		4096u
 
+/* freestanding build: clang's -ffreestanding implies -fno-builtin, so strcmp
+ * stays an external call (gcc inlines the constant-arg uses instead) */
+int strcmp(const char *a, const char *b)
+{
+	while (*a && *a == *b)
+		a++, b++;
+	return (unsigned char)*a - (unsigned char)*b;
+}
+
 static inline uint32_t ufs_rd(uint32_t off) { return *(volatile uint32_t *)(UFS_BASE + off); }
 static inline void ufs_wr(uint32_t off, uint32_t v) { *(volatile uint32_t *)(UFS_BASE + off) = v; }
 
